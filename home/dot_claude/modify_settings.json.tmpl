#!/usr/bin/env python3
# chezmoi modify script: merge the managed subset into ~/.claude/settings.json.
# Keys written by Claude Code, plugins or peon-ping-setup are preserved.
import json
import sys

HOME = {{ .chezmoi.homeDir | quote }}
MANAGED = json.loads({{ .agents.claude | toJson | quote }})

raw = sys.stdin.read()
try:
    settings = json.loads(raw) if raw.strip() else {}
except ValueError:
    settings = {}

for key, value in MANAGED["settings"].items():
    settings[key] = value

settings["statusLine"] = {"type": "command", "command": f"bash {HOME}/.claude/statusline-command.sh"}

enabled = settings.setdefault("enabledPlugins", {})
for plugin in MANAGED["plugins"]:
    enabled.setdefault(plugin, True)

known = settings.setdefault("extraKnownMarketplaces", {})
for market in MANAGED["marketplaces"]:
    if market["name"] == "claude-plugins-official":
        continue
    if "source_path" in market:
        known[market["name"]] = {"source": {"source": "directory", "path": f"{HOME}/{market['source_path']}"}}
    else:
        known[market["name"]] = {"source": {"source": "github", "repo": market["source"]}}

sys.stdout.write(json.dumps(settings, indent=2) + "\n")
